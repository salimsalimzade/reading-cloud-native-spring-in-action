      "enabled": true,
      "realmRoles": [
        "employee",
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    },
    {
      "username": "jackdorsey",
      "firstName": "Jack",
      "lastName": "Dorsey",
